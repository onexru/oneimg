# oneImg v3.5.5 prebuilt runtime image.
# 与原 Dockerfile 的 runtime 层保持一致（alpine:3.23 + ca-certificates +
# tzdata + libwebp + dist + ca/ + data/uploads 目录），但直接使用预编译并
# 经 UPX -9 压缩的二进制，跳过容器内编译以支持离线/快速分发。
# 构建时通过 --build-arg BINARY 指定对应架构的二进制路径。
ARG TARGETARCH
FROM alpine:3.23
ARG BINARY
RUN apk add --no-cache ca-certificates tzdata libwebp
WORKDIR /app
COPY ${BINARY} /app/oneimg
COPY frontend/dist ./frontend/dist
COPY ca/ ./ca/
RUN mkdir -p /app/data /app/uploads
EXPOSE 8080
CMD ["/app/oneimg"]
